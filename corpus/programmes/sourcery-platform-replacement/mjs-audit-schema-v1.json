{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcery/platform-mjs-audit/1",
  "title": "Sourcery platform and shell MJS audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "auditId",
    "basis",
    "entrypoints",
    "modules",
    "dynamicResiduals",
    "summary",
    "authority"
  ],
  "properties": {
    "protocol": {
      "const": "sourcery/platform-mjs-audit/1"
    },
    "auditId": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "$ref": "#/$defs/sourceBasis"
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entrypointId",
          "sourceRef",
          "selectionEvidence",
          "status"
        ],
        "properties": {
          "entrypointId": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "$ref": "#/$defs/sourceRef"
          },
          "selectionEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "selected",
              "historical",
              "candidate",
              "unknown"
            ]
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "dynamicResiduals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/residual"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleCount",
        "functionCount",
        "classificationCounts",
        "dispositionCounts",
        "closedEntrypointSet",
        "complete"
      ],
      "properties": {
        "moduleCount": {
          "type": "integer",
          "minimum": 0
        },
        "functionCount": {
          "type": "integer",
          "minimum": 0
        },
        "classificationCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dispositionCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "closedEntrypointSet": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantsReceiving",
        "grantsMerge",
        "grantsAdoption",
        "grantsActivation"
      ],
      "properties": {
        "grantsReceiving": {
          "const": false
        },
        "grantsMerge": {
          "const": false
        },
        "grantsAdoption": {
          "const": false
        },
        "grantsActivation": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sourceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "identity",
        "observedThrough"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "git",
            "temple-workspace"
          ]
        },
        "identity": {
          "type": "object"
        },
        "observedThrough": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "path",
        "sha256"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "git",
            "temple-workspace"
          ]
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "laneId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "git"
              }
            }
          },
          "then": {
            "required": [
              "repository",
              "commit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "temple-workspace"
              }
            }
          },
          "then": {
            "required": [
              "laneId",
              "snapshotId"
            ]
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "sourceRef",
        "reachableFrom",
        "staticEdges",
        "dynamicEdges",
        "topLevelEffects",
        "functions",
        "moduleDisposition"
      ],
      "properties": {
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "reachableFrom": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "staticEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "dynamicEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "topLevelEffects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function"
          }
        },
        "moduleDisposition": {
          "enum": [
            "mixed",
            "digest",
            "retain-kernel",
            "retain-interpreter",
            "retain-evidence",
            "retire",
            "quarantine"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specifier",
        "resolution",
        "evidence"
      ],
      "properties": {
        "specifier": {
          "type": "string"
        },
        "resolution": {
          "enum": [
            "resolved",
            "external",
            "runtime-selected",
            "unknown"
          ]
        },
        "targetModuleId": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionId",
        "sourceSpan",
        "bodySha256",
        "classifications",
        "semanticCoordinates",
        "effects",
        "disposition",
        "reason",
        "witnessRefs"
      ],
      "properties": {
        "functionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startLine",
            "endLine"
          ],
          "properties": {
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "bodySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "semantic-decision",
              "interpreter-primitive",
              "fixed-codec",
              "external-effect",
              "byte-or-state-observation",
              "evidence-fixture",
              "dead-or-duplicate",
              "unknown"
            ]
          }
        },
        "semanticCoordinates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem",
              "network",
              "process",
              "database",
              "clock",
              "randomness",
              "cryptography",
              "runtime-loader",
              "browser",
              "none",
              "unknown"
            ]
          }
        },
        "disposition": {
          "enum": [
            "digest-to-algebra",
            "retain-in-kernel",
            "retain-as-interpreter",
            "retain-as-evidence",
            "retire-after-crossing",
            "quarantine-pending-evidence"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "witnessRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seamRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symmetryBreakRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residualId",
        "kind",
        "observation",
        "owner",
        "disposition",
        "blocks",
        "falsifier"
      ],
      "properties": {
        "residualId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "dynamic-load",
            "generated-source",
            "runtime-selection",
            "foreign-process",
            "missing-source",
            "ambiguous-identity",
            "other"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "open",
            "accepted",
            "resolved",
            "refused"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "falsifier": {
          "type": "string",
          "minLength": 1
        },
        "resolutionWitnessRef": {
          "type": "string"
        }
      }
    }
  }
}
