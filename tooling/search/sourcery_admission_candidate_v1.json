{
  "protocol": "spin23-corpus-search-sourcery-admission-candidate/1",
  "status": "local-candidate-not-protected-runtime-admitted",
  "purpose": "A sealed-source candidate for read-only corpus retrieval, tailored context, selector sweeps, answer-provenance comparison and caller-owned bounded source-utility learning through the Sourcery MCP lifecycle.",
  "authorityBoundary": {
    "readOnly": true,
    "entails": false,
    "empiricalAuthority": false,
    "corpusPromotion": false,
    "applicationAdmission": false,
    "protectedRuntimeSelected": false
  },
  "tools": [
    {
      "name": "corpus_search",
      "description": "Search the canonical research corpus. Combines weighted lexical relevance with personalized PageRank over authored Markdown links, returns declared epistemic status and reports selector-prior sensitivity. Ranking is a navigation aid, not evidence or truth.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "description": "Natural-language question or compact concept query."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          },
          "profile": {
            "type": "string",
            "enum": [
              "all",
              "interpret",
              "choose-work",
              "audit",
              "experiment"
            ],
            "default": "all",
            "description": "Optional front-door prior matching the LLM's present task."
          },
          "graphWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.6,
            "default": 0.3,
            "description": "Declared contribution of graph context to final navigation order."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_context",
      "description": "Build a task-tailored, character-budgeted context packet from diverse corpus sources. Includes query-centered excerpts, source boundaries, declared statuses, inclusion reasons, selector-sensitivity warnings and explicit omissions. Use this to prepare an LLM working context; it does not establish truth.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "description": "The concrete question or work the receiving LLM must perform."
          },
          "profile": {
            "type": "string",
            "enum": [
              "all",
              "interpret",
              "choose-work",
              "audit",
              "experiment"
            ],
            "default": "all"
          },
          "maxSources": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "default": 6
          },
          "maxCharacters": {
            "type": "integer",
            "minimum": 4000,
            "maximum": 30000,
            "default": 12000
          },
          "graphWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.6,
            "default": 0.3
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_context_sweep",
      "description": "Run a bounded one-factor-at-a-time sweep over context profile and graph influence. Reports invariant, robust and selector-sensitive source sets with pairwise overlap and reproducible receipts. This measures context stability; the host must run the same model prompt on each included packet to test answer stability.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "baselineProfile": {
            "type": "string",
            "enum": [
              "all",
              "interpret",
              "choose-work",
              "audit",
              "experiment"
            ],
            "default": "all"
          },
          "profiles": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "all",
                "interpret",
                "choose-work",
                "audit",
                "experiment"
              ]
            },
            "default": [
              "interpret",
              "experiment",
              "audit"
            ]
          },
          "baselineGraphWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.6,
            "default": 0.3
          },
          "graphWeights": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.6
            },
            "default": [
              0.15,
              0.3,
              0.45
            ]
          },
          "maxSources": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "default": 6
          },
          "maxCharacters": {
            "type": "integer",
            "minimum": 4000,
            "maximum": 16000,
            "default": 8000
          },
          "includeContexts": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_answer_receipt",
      "description": "Bind one LLM answer and its atomic claims to an exact context receipt, model configuration and cited source identities. Reports citations outside the supplied context. This is provenance, not scientific certification.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contextReceipt": {
            "type": "object"
          },
          "contextSources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object"
            }
          },
          "model": {
            "type": "object"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "contextReceipt",
          "contextSources",
          "model",
          "prompt",
          "answer",
          "claims"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_answer_stability",
      "description": "Compare two to eight answer receipts produced under distinct context packets. Classifies stable exact claims, stable verdicts with wording drift, context-conditional claims, verdict conflicts and unsupported citations. Exact-key comparison does not prove semantic equivalence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "receipts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "receipts"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_belief_initialize",
      "description": "Initialize a caller-owned, corpus-bound belief state for one externally supplied objective. The state estimates source utility for context selection; it does not estimate truth, change claim status, mutate the corpus or train model weights.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "profile": {
            "type": "string",
            "enum": [
              "all",
              "interpret",
              "choose-work",
              "audit",
              "experiment"
            ],
            "default": "all"
          },
          "processVariance": {
            "type": "number",
            "minimum": 0.0001,
            "maximum": 0.1,
            "default": 0.01
          }
        },
        "required": [
          "objective"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_belief_update",
      "description": "Apply one to 200 typed observations to a hash-verified caller-owned belief state using bounded scalar Kalman-like source-utility updates. Returns a successor state and innovation receipt without server-side persistence or corpus mutation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beliefState": {
            "type": "object"
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "beliefState",
          "observations"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_adaptive_context",
      "description": "Build a context packet using bounded learned source utility and uncertainty while returning the unadapted baseline, rank movements and authority limits. Adaptive influence is capped at 0.2 and cannot change truth or corpus status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "beliefState": {
            "type": "object"
          },
          "profile": {
            "type": "string",
            "enum": [
              "all",
              "interpret",
              "choose-work",
              "audit",
              "experiment"
            ]
          },
          "maxSources": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "default": 6
          },
          "maxCharacters": {
            "type": "integer",
            "minimum": 4000,
            "maximum": 30000,
            "default": 12000
          },
          "graphWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.6,
            "default": 0.3
          },
          "adaptiveWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.2,
            "default": 0.15
          },
          "explorationWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.05,
            "default": 0.03
          }
        },
        "required": [
          "task",
          "beliefState"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "corpus_read",
      "description": "Read a bounded UTF-8 slice of one Markdown document returned by corpus_search. Read-only and restricted to the indexed corpus roots.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Repository-relative path returned by corpus_search."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Character offset in the UTF-8 text."
          },
          "maxCharacters": {
            "type": "integer",
            "minimum": 256,
            "maximum": 30000,
            "default": 12000
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ],
