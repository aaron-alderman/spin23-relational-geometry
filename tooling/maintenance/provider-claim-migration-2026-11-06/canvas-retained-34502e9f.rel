// Canonical Canvas authored interface catalogue.
// The renderer remains an interpreter; these facts own the authored shapes and vocabularies.

("canvas.catalogue.module", "isa", "AlgebraModule")
("canvas.catalogue.module", "sourceDomain", "AuthoredCanvasFactsObservedByCurrentRendererAndWorkbenchAuthoringDocumentation")
("canvas.catalogue.module", "targetDomain", "ClosedCanvasInterfacesSlotsAndDispatchVocabularies")
("canvas.catalogue.module", "forwardMap", "validateAuthoredCanvasFactsAgainstClosedInterfacesThenInterpretThroughThinBrowserBoundary")
("canvas.catalogue.module", "reverseMapOrAbsence", "partial.RenderedPixelsRuntimeStateAndEffectsCannotRecoverOriginalFactOrderNegationHistoryOrRejectedFacts")
("canvas.catalogue.module", "preservedInformation", "typePredicateCardinalityValueTypeAllowedVocabularyRequirednessDefaultsAuthorityEffectsFailuresAndSourceIdentity")
("canvas.catalogue.module", "lostInformation", "factOrderNegationHistoryBrowserEventIdentityFrameTimingAndEffectAdapterInternals")
("canvas.catalogue.module", "identity", "interfaceTypeAndSlotPredicate")
("canvas.catalogue.module", "partiality", "unknownTypesPredicatesAndVocabularyValuesFailClosed;conditionalRequirednessIsDeclaredOnTheSlot")
("canvas.catalogue.module", "failure", "typedCanvasProjectionDiagnosticBeforeSemanticMutationOrEffectExecution")
("canvas.catalogue.module", "authorityEffect", "authoredFactsOwnSemantics;rendererMayOnlyProjectAndRequestDeclaredEffects")
("canvas.catalogue.module", "stateOwner", "authoredProgramForConfigurationAndBrowserViewStateForExplicitStateKeys")
("canvas.catalogue.module", "evidence", "sdk/browser/canvas-renderer.mjs;sdk/core/docs/workbench-authoring-guide.md;sdk/core/docs/default-behaviors.md")
("canvas.catalogue.module", "falsifier", "rendererConsumesAnAuthoredCanvasTypePredicateOrVocabularyValueAbsentFromThisCatalogue")
("canvas.catalogue.module", "default", "onlyDefaultsExplicitlyDeclaredOnSlots;allOthersNone")
("canvas.catalogue.module", "adapterSeam", "sdk/browser/canvas-renderer.mjs")
("canvas.catalogue.module", "symmetryBreak", "renderingDropsFactOrderAndBrowserEffectsDropEventIdentity;eachLossIsExplicitlyOutsideAuthoredCanvasIdentity")

