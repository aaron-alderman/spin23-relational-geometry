  "decisions": [
    "Keep selected authored action-policy owner rather than restore the private operation table.",
    "Keep selected slot helpers including public default and reference normalization semantics.",
    "Pass authored policy facts into recovered action builders and removable-value helpers.",
    "Supply selected stdlib policy explicitly in five historical test fixtures; preserve all expected assertions.",
    "Carry actor and semantic index across the property application boundary.",
    "Scalar replacement emits old-value retractions before the new positive fact to preserve later schema admission."
  ],
  "scope": "Exact history-backed recovery plus declared reconciliation; not blanket equivalence between old modular source and selected predecessor monolith."
}
