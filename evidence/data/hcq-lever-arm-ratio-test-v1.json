  "cancellationTheorem": {
    "strength": "If d(Phi)=eta Dbar(Phi) with the same scalar eta at every bias, |d_j0(Phi)|^2/|d_k0(Phi_ref)|^2 is eta-independent, provided the denominator is nonzero.",
    "isolatedForce": "In leading CP order, for one fixed electric channel with alpha(Phi,i xi)=eta^2 alphabar(Phi,i xi), F(Phi)=eta^2 Fbar(Phi). The pure-channel force ratio cancels eta.",
    "totalForce": "For F_total(Phi)=B+eta^2 Fbar(Phi), an unknown flux-independent B does not cancel in a simple ratio. It cancels in [F(Phi)-F(Phi0)]/[F(Phi1)-F(Phi0)].",
    "conditions": [
      "Fixed geometry and source direction.",
      "Scalar lever arm constant over flux and the contributing frequencies, or an independently known frequency shape times one unknown amplitude.",
      "Known physical source operator, common state/preparation and modeled contacts.",
      "Single isolated force channel or controlled subtraction of other contributions."
    ],
    "boundaries": [
      "An unknown frequency-dependent weighting remains inside the integral.",
      "Electric and magnetic channels with different unknown gains do not share one scalar cancellation.",
      "General multiple-scattering log determinants are nonlinear in response strength; simple cancellation is a leading weak-coupling/CP statement.",
      "Flux-dependent contacts, temperatures/populations, screening, backgrounds or transfer functions require their own matching."
    ]
  },
