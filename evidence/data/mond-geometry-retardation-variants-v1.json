      "id": "V1",
      "name": "instantaneous AQUAL simple-mu",
      "modificationSite": "nonlinear elliptic field constitutive law",
      "equation": "div[mu(|grad Phi|/a0) grad Phi] = 4 pi G rho; mu(y)=y/(1+y)",
      "geometry": "matter-centred nonlinear spatial response; spherical vacuum potential tends to sqrt(G M a0) ln r",
      "retardation": "none in the nonrelativistic equation; a relativistic/hyperbolic completion remains required",
      "identifies": [
        "deep-MOND logarithmic lapse candidate",
        "BTFR normalization once a0 is fixed",
        "instantaneous modified-gravity EFE"
      ],
      "doesNotIdentify": [
        "lensing metric",
        "causal propagation kernel"
      ]
    },
    {
      "id": "V2",
      "name": "instantaneous QUMOND standard-nu",
      "modificationSite": "nonlinear source construction followed by linear Poisson solve",
      "equation": "Delta Phi = div[nu(|grad Phi_N|/a0) grad Phi_N]",
      "geometry": "ordinary Poisson geometry sourced by baryons plus a derived phantom-density field",
      "retardation": "none in the nonrelativistic equation",
      "identifies": [
        "same deep and Newtonian limits as V1",
        "different transition-region and nonspherical source geometry"
      ],
      "doesNotIdentify": [
        "relativistic lensing completion",
        "time-domain response"
      ]
    },
    {
      "id": "V3",
      "name": "external-field anisotropic AQUAL",
      "modificationSite": "linearized constitutive tensor around an external field",
      "equation": "mu_e [Delta + L_e partial_parallel^2] deltaPhi = 4 pi G deltaRho",
      "geometry": "environment-selected axis with unequal parallel and perpendicular susceptibility",
      "retardation": "instantaneous; the external field is evaluated at the current state",
      "identifies": [
        "modified-gravity EFE",
        "quadrupolar/anisotropic internal response"
      ],
      "doesNotIdentify": [
        "orbital-history dependence"
      ]
    },
    {
      "id": "V4",
      "name": "causal relaxation of the MOND field excess",
      "modificationSite": "retarded field response",
      "equation": "g(omega)=g_N+[g_MOND(g_N)-g_N]/(1-i omega tau)",
      "geometry": "V1 static geometry with a causal relaxation fibre; tau must be derived rather than fitted per object",
      "retardation": "exponential retarded kernel acting only on the MOND excess",
      "identifies": [
        "static V1 at zero frequency",
        "frequency-dependent suppression and phase lag"
      ],
      "doesNotIdentify": [
        "a covariant parent action",
        "whether tau is universal or dynamically generated"
      ]
    },
    {
      "id": "V5",
      "name": "trajectory-memory modified inertia",
      "modificationSite": "inertial response of trajectories",
      "equation": "g_N(t)=mu(q(t)) g(t), q=K_ret * |g| / a0",
      "geometry": "history space rather than a purely spatial metric; the state is a trajectory functional",
      "retardation": "causal memory; linear response depends on internal/external frequency ratios",
      "identifies": [
        "static simple-mu law",
        "history-sensitive EFE and noncircular response"
      ],
      "doesNotIdentify": [
        "unique memory kernel",
        "relativistic lensing law"
      ]
    }
